# Copy to .env and fill in real values: cp .env.example .env
# The relay does not load this file itself; export it into the shell first:
#   set -a; source .env; set +a
# Never commit .env (it is in .gitignore). Generate secrets with: openssl rand -hex 32

# Required
# PostgreSQL connection string; this one matches `docker compose up -d`.
DATABASE_URL=postgres://relay:relay@localhost:5434/relay
# provider=secret pairs, comma-separated. Names: a-z, 0-9, -. Secrets: 32+ characters.
PROVIDER_SECRETS=acme-pay=replace-with-a-secret-of-32-or-more-characters
# http(s) URL that receives every event.
DELIVERY_URL=http://localhost:9000/events
# Secret the relay signs deliveries with, 32+ characters.
DELIVERY_SECRET=replace-with-a-secret-of-32-or-more-characters

# Optional (defaults shown)
# MAX_ATTEMPTS=8
# SIGNATURE_TOLERANCE=5m
# PORT=8080
# Export traces over OTLP/HTTP; leave unset to export nothing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Store tests only: a database they may empty (`docker compose up -d` creates it).
# TEST_DATABASE_URL=postgres://relay:relay@localhost:5434/relay_test
